+/**
+ * Orca: a popup a page opens (window.open) when the page has no onOpenWindow handler.
+ *
+ * Upstream handed such a popup a bare WebView with no client, so Android passed its first load to
+ * the browser: claude.ai's "Continue with Google" became a blank accounts.google.com tab in Chrome,
+ * cut off from the page that opened it, and the sign-in could never come back (2026-10-17).
+ *
+ * A popup that reaches Google's sign-in is kept here instead: drawn over the page that opened it,
+ * still that page's window.opener so Google can hand the result back, and closed when Google closes
+ * it. Its requests go out the way Orca's desktop browser sends Google's sign-in pages (Orca
+ * 1.4.229, browser-route identity "google-auth"): a Firefox user agent, which carries no Chromium
+ * client hints, and without the X-Requested-With header that names the app. Google refuses a
+ * sign-in it recognises as an embedded WebView. A popup to the opener's own site may redirect on to
+ * Google, so it loads unseen until it does; any other popup still opens in the browser.
+ */
+final class RNCGoogleSignInPopup {
+    private static final String TAG = "RNCGoogleSignInPopup";
+
+    private RNCGoogleSignInPopup() {}
+
+    static boolean isGoogleSignIn(@Nullable Uri uri) {
+        if (uri == null || uri.getHost() == null) {
+            return false;
+        }
+        String host = uri.getHost().toLowerCase(Locale.ROOT);
+        return host.equals("accounts.google.com") || host.equals("accounts.youtube.com");
+    }
+
+    /** Firefox for Android's own user agent shape, as Orca uses Firefox's for desktop. */
+    static String firefoxUserAgent() {
+        String release = Build.VERSION.RELEASE == null ? "14" : Build.VERSION.RELEASE;
+        return "Mozilla/5.0 (Android " + release + "; Mobile; rv:140.0) Gecko/140.0 Firefox/140.0";
+    }
+
+    private static boolean isWeb(Uri uri) {
+        String scheme = uri.getScheme() == null ? "" : uri.getScheme().toLowerCase(Locale.ROOT);
+        return scheme.equals("https") || scheme.equals("http");
+    }
+
+    private static boolean sameHost(@Nullable String a, @Nullable String b) {
+        return a != null && b != null && a.equalsIgnoreCase(b);
+    }
+
+    /** Hands `resultMsg` a popup WebView owned by the page in `opener`. */
+    static void open(final WebView opener, Message resultMsg) {
+        final WebView popup = new WebView(opener.getContext());
+        WebSettings settings = popup.getSettings();
+        settings.setJavaScriptEnabled(true);
+        settings.setDomStorageEnabled(true);
+        settings.setJavaScriptCanOpenWindowsAutomatically(true);
+        settings.setUserAgentString(firefoxUserAgent());
+        CookieManager.getInstance().setAcceptThirdPartyCookies(popup, true);
+        if (WebViewFeature.isFeatureSupported(WebViewFeature.REQUESTED_WITH_HEADER_ALLOW_LIST)) {
+            try {
+                WebSettingsCompat.setRequestedWithHeaderOriginAllowList(settings, Collections.<String>emptySet());
+            } catch (RuntimeException e) {
+                FLog.w(TAG, "Could not drop X-Requested-With from the sign-in popup", e);
+            }
+        }
+        popup.setBackgroundColor(Color.WHITE);
+        final String openerHost = opener.getUrl() == null ? null : Uri.parse(opener.getUrl()).getHost();
+        final Popup state = new Popup(opener, popup);
+        popup.setWebViewClient(new WebViewClient() {
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                Uri uri = request.getUrl();
+                if (state.shown) {
+                    // Inside the sign-in: web pages stay here, an app link has nowhere to go.
+                    return !isWeb(uri);
+                }
+                if (isGoogleSignIn(uri)) {
+                    state.show();
+                    return false;
+                }
+                if (isWeb(uri) && sameHost(uri.getHost(), openerHost)) {
+                    // The opener's own site, which may redirect on to Google: load it unseen.
+                    return false;
+                }
+                // Not a sign-in: the browser, as upstream did. The popup is dropped once this
+                // callback has returned, not from inside it.
+                openInBrowser(opener, uri);
+                opener.post(state::close);
+                return true;
+            }
+
+            @Override
+            public void onPageFinished(WebView view, String url) {
+                // A page of the opener's own site that did not go on to Google: show it rather than
+                // leave an unseen window behind a button that seemed to do nothing.
+                Uri page = url == null ? null : Uri.parse(url);
+                if (!state.shown && !state.closed && page != null && isWeb(page) && sameHost(page.getHost(), openerHost)) {
+                    state.show();
+                }
+            }
+
+            @Override
+            public boolean onRenderProcessGone(WebView view, RenderProcessGoneDetail detail) {
+                // The popup's renderer is gone: drop the popup, never the app.
+                FLog.w(TAG, "The sign-in popup's renderer went away");
+                state.close();
+                return true;
+            }
+        });
+        popup.setWebChromeClient(new WebChromeClient() {
+            @Override
+            public void onCloseWindow(WebView window) {
+                state.close();
+            }
+        });
+        WebView.WebViewTransport transport = (WebView.WebViewTransport) resultMsg.obj;
+        transport.setWebView(popup);
+        resultMsg.sendToTarget();
+    }
+
+    /** One popup over its opener's wrapper: shown, sized with it, and gone with it. */
+    private static final class Popup implements View.OnLayoutChangeListener, View.OnAttachStateChangeListener {
+        final WebView opener;
+        final WebView popup;
+        boolean shown = false;
+        boolean closed = false;
+        @Nullable FrameLayout host = null;
+
+        Popup(WebView opener, WebView popup) {
+            this.opener = opener;
+            this.popup = popup;
+            // The screen that opened it goes away (the sign-in is closed): so does the popup.
+            opener.addOnAttachStateChangeListener(this);
+        }
+
+        void show() {
+            if (shown || closed || !(opener.getParent() instanceof FrameLayout)) {
+                return;
+            }
+            shown = true;
+            host = (FrameLayout) opener.getParent();
+            host.addView(popup, new FrameLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+            // React Native's parent view ignores requestLayout (its UIManager lays children out), so
+            // a view added here is never measured: size it to the wrapper now and on every resize.
+            fit();
+            host.addOnLayoutChangeListener(this);
+        }
+
+        void fit() {
+            if (host == null) {
+                return;
+            }
+            int width = host.getWidth();
+            int height = host.getHeight();
+            popup.measure(
+                    View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
+                    View.MeasureSpec.makeMeasureSpec(height, View.MeasureSpec.EXACTLY));
+            popup.layout(0, 0, width, height);
+        }
+
+        void close() {
+            if (closed) {
+                return;
+            }
+            closed = true;
+            opener.removeOnAttachStateChangeListener(this);
+            if (host != null) {
+                host.removeOnLayoutChangeListener(this);
+                host.removeView(popup);
+                host = null;
+            }
+            popup.destroy();
+        }
+
+        @Override
+        public void onLayoutChange(View v, int left, int top, int right, int bottom,
+                                   int oldLeft, int oldTop, int oldRight, int oldBottom) {
+            if (right - left != oldRight - oldLeft || bottom - top != oldBottom - oldTop) {
+                fit();
+            }
+        }
+
+        @Override
+        public void onViewAttachedToWindow(View v) {}
+
+        @Override
+        public void onViewDetachedFromWindow(View v) {
+            close();
+        }
+    }
+
+    private static void openInBrowser(WebView opener, Uri uri) {
+        if (!isWeb(uri)) {
+            return;
+        }
+        try {
+            Intent intent = new Intent(Intent.ACTION_VIEW, uri);
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            opener.getContext().startActivity(intent);
+        } catch (ActivityNotFoundException e) {
+            FLog.w(TAG, "No browser for a popup", e);
+        }
+    }
+}
