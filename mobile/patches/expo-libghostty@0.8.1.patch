+// A TUI that asked for mouse tracking owns the scroll gesture: the finger must
+// become a wheel report, not a scrollback move. Reported as a bitmask so one
+// JNI call answers a whole gesture rather than one per touch sample.
+JNIEXPORT jint JNICALL
+Java_expo_modules_libghostty_GhosttyVt_nativeTerminalModes(JNIEnv*, jobject, jlong handle) {
+  auto* session = fromHandle(handle);
+  if (session == nullptr) return 0;
+  jint flags = 0;
+  bool value = false;
+  if (ghostty_terminal_mode_get(session->term, GHOSTTY_MODE_NORMAL_MOUSE, &value) ==
+          GHOSTTY_SUCCESS && value) flags |= 1 << 0;
+  if (ghostty_terminal_mode_get(session->term, GHOSTTY_MODE_BUTTON_MOUSE, &value) ==
+          GHOSTTY_SUCCESS && value) flags |= 1 << 1;
+  if (ghostty_terminal_mode_get(session->term, GHOSTTY_MODE_ANY_MOUSE, &value) ==
+          GHOSTTY_SUCCESS && value) flags |= 1 << 2;
+  if (ghostty_terminal_mode_get(session->term, GHOSTTY_MODE_SGR_MOUSE, &value) ==
+          GHOSTTY_SUCCESS && value) flags |= 1 << 3;
+  // Three DEC modes open the alternate screen; Claude Code uses 1049.
+  if (ghostty_terminal_mode_get(session->term, GHOSTTY_MODE_ALT_SCREEN, &value) ==
+          GHOSTTY_SUCCESS && value) flags |= 1 << 4;
+  if (ghostty_terminal_mode_get(session->term, GHOSTTY_MODE_ALT_SCREEN_SAVE, &value) ==
+          GHOSTTY_SUCCESS && value) flags |= 1 << 4;
+  if (ghostty_terminal_mode_get(session->term, GHOSTTY_MODE_ALT_SCREEN_LEGACY, &value) ==
+          GHOSTTY_SUCCESS && value) flags |= 1 << 4;
+  if (ghostty_terminal_mode_get(session->term, GHOSTTY_MODE_ALT_SCROLL, &value) ==
+          GHOSTTY_SUCCESS && value) flags |= 1 << 5;
