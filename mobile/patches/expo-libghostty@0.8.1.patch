+// Position is surface-space PIXELS; the encoder converts to cells using the
+// cell size handed to nativeResize. Buttons follow X11 numbering, so wheel up
+// and down are FOUR and FIVE.
+JNIEXPORT jbyteArray JNICALL
+Java_expo_modules_libghostty_GhosttyVt_nativeEncodeMouse(
+    JNIEnv* env, jobject, jlong handle, jint button, jint action, jfloat x, jfloat y,
+    jint metaState) {
+  auto* session = fromHandle(handle);
+  if (session == nullptr) return nullptr;
+
+  // Mouse modes change as programs run (Claude Code enables 1000/1002/1003/1006
+  // in its first chunk); sync before every encode so the format follows.
+  ghostty_mouse_encoder_setopt_from_terminal(session->mouseEncoder, session->term);
+
+  GhosttyMouseAction mouseAction = GHOSTTY_MOUSE_ACTION_PRESS;
+  if (action == 1) mouseAction = GHOSTTY_MOUSE_ACTION_RELEASE;
+  if (action == 2) mouseAction = GHOSTTY_MOUSE_ACTION_MOTION;
+
+  ghostty_mouse_event_set_action(session->mouseEvent, mouseAction);
+  ghostty_mouse_event_set_button(session->mouseEvent,
+                                 static_cast<GhosttyMouseButton>(button));
+  ghostty_mouse_event_set_mods(session->mouseEvent, mapMods(metaState));
+  GhosttyMousePosition position{x, y};
+  ghostty_mouse_event_set_position(session->mouseEvent, position);
+
+  char stackBuf[64];
+  size_t written = 0;
+  GhosttyResult result = ghostty_mouse_encoder_encode(session->mouseEncoder,
+                                                      session->mouseEvent, stackBuf,
+                                                      sizeof(stackBuf), &written);
+  std::vector<char> heapBuf;
+  const char* out = stackBuf;
+  if (result == GHOSTTY_OUT_OF_SPACE) {
+    heapBuf.resize(written);
+    result = ghostty_mouse_encoder_encode(session->mouseEncoder, session->mouseEvent,
+                                          heapBuf.data(), heapBuf.size(), &written);
+    out = heapBuf.data();
+  }
+
+  if (result != GHOSTTY_SUCCESS || written == 0) return nullptr;
+  jbyteArray outArray = env->NewByteArray(static_cast<jsize>(written));
+  if (outArray == nullptr) return nullptr;
+  env->SetByteArrayRegion(outArray, 0, static_cast<jsize>(written),
+                          reinterpret_cast<const jbyte*>(out));
+  return outArray;
+}
