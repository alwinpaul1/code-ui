<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- openUrlOutsideApp lists the installed browsers. Android 11+ hides other apps from
       queryIntentActivities unless the manifest declares the query; this merges into the app's. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" />
    </intent>
  </queries>
</manifest>
