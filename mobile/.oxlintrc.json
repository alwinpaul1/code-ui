{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../.oxlintrc.json"
  ],
  "ignorePatterns": [
    "src/terminal/terminal-webview-engine.generated.ts"
  ],
  "rules": {
    "react-hooks/exhaustive-deps": "off",
    "react/no-unescaped-entities": "off",
    "typescript/array-type": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/consistent-type-imports": "off",
    "prefer-template": "off",
    "no-useless-return": "off",
    "unicorn/prefer-at": "off",
    "unicorn/prefer-ternary": "off",
    "unicorn/prefer-node-protocol": "off"
  },
  "overrides": [
    {
      "files": [
        "src/components/MobileMarkdown.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            // 2026-09-19: +16 for images that draw — the image block and the
            // resolver prop threaded to it (MobileMarkdownImage.tsx holds the
            // drawing), and the rule/image spans inside the selectable run.
            // Later that day +4: lists and quotes moved INTO the run as spans
            // (so a selection can cross them); their View branches went, the
            // span branches are a little longer.
            "max": 420,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/terminal/TerminalWebView.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 379,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "app/h/*/source-control/*.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 2152,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "app/index.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 1422,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/transport/rpc-client.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 1074,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "scripts/mock-server.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 407,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "app/h/*/files/*.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 402,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/transport/mobile-endpoint-supervisor.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 413,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/session/use-mobile-native-chat-controller.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            // 2026-09-18: +12 for handleNativeChatRespondPermissionWithComment
            // — the plan-review comment sheet's TUI-lane wiring, via
            // useMobileNativeChatPlanFeedbackRespond (the actual send logic
            // lives in its own file, not here).
            // 2026-09-18: +5 for legacyRenderedPermission — the card as
            // rendered, computed once and handed to the permission send hook
            // as cardPermission, so a plan-review approval tap can be checked
            // against the highlighted row (the check itself lives in
            // mobile-native-chat-permission-send.ts).
            // 2026-09-19: +17 for the transcript tail — useTranscriptTail's enable
            // condition and the merged queue/prompts it hands the contract;
            // the tail itself lives in session/transcript-tail/.
            "max": 496,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/session/use-mobile-native-chat-session-options.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 445,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/session/use-mobile-native-chat-drafts.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 320,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/transport/host-store.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 320,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/session/MobileNativeChatView.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            // 2026-09-18: +4 when three same-day ports met here — the rewind
            // hook + sheet, the revert-hunk prop, and the focus-view store
            // read. Each stayed under 405 on its own branch; the merge did
            // not. Each feature's logic lives in its own module; this file
            // only threads them.
            // 2026-09-19: +1 for onPasteImageFile — an image the keyboard put
            // into the composer, threaded to it; the module is expo-rich-paste.
            "max": 410,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/session/agent-hud-launch-args.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            // 2026-09-18: +9 for `sid=` on every emitter (status line, Stop
            // hook, prompt hook, Codex notify; sh and PowerShell), so a beacon
            // names the session it came from. +4 the same day for the
            // heartbeat: `refreshInterval` on the settings and `hb=` on the
            // status-line beacon, so silence means something, with a slower
            // beat for Windows where each run is a PowerShell process.
            "max": 315,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/session/agent-hud-beacon.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            // 2026-09-18: +17 for the session id on a beacon (parse, replace
            // the handle's record when the session changes) and the arrival
            // clock the liveness rule reads. +3 the same day for the beat a
            // beacon declares (`hb=`), parsed and kept across a merge.
            "max": 325,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    }
  ]
}
