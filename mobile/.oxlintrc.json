    {
      "files": [
        "src/terminal/TerminalWebView.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 379,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "app/h/*/source-control/*.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 2152,
            "skipBlankLines": true,
            "skipComments": true
          }
