<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- Why: Android 14 refuses startForeground() unless the declared type's
       permission is held. The service relays messages between the desktop
       agents and this phone, which is what REMOTE_MESSAGING is for; unlike
       DATA_SYNC it carries no daily time budget on Android 15. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
  <!-- HeadlessJsTaskService.startTask() takes a partial wake lock. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Why: Doze suspends network and ignores wake locks for every app that is
       not exempt from battery optimisation — a foreground service does not
       change that. The app asks for the exemption when background delivery is
       switched on; it is what Play permits for apps whose core job is a live
       messaging link. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <service
      android:name="expo.modules.backgroundlink.BackgroundLinkService"
      android:exported="false"
      android:foregroundServiceType="remoteMessaging"
      android:stopWithTask="false" />
  </application>
</manifest>
